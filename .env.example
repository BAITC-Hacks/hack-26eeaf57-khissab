# Backend
APP_ENV=local
DATA_DIR=/app/data
# Container /app/storage is mounted from the gitignored repo /storage/ directory.
# First startup creates and seeds this SQLite file; restarts preserve progress.
DATABASE_URL=sqlite:////app/storage/career_quest.sqlite3
# Local run from the repo root: DATA_DIR=./data
# Local run from the repo root: DATABASE_URL=sqlite:///./storage/career_quest.sqlite3

# P2 scoring is offline; fixed weights live in backend/engine.py, not environment variables.
# Optional LLM explanation layer (P3).
# docker compose up works without this key; backend falls back to deterministic templates.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
