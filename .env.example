# Backend
APP_ENV=local
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/storage/career_quest.sqlite3

# Optional LLM explanation layer.
# docker compose up works without this key; backend falls back to deterministic templates.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
